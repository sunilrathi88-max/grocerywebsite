{
  "name": "rathi-naturals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "build": "npm run generate:sitemap && vite build",
    "postbuild": "node scripts/prerender.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest \"(hooks|utils)\" --coverage",
    "test:components": "jest \"components\" --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "images:generate": "node scripts/generate-product-images.mjs",
    "images:generate:overwrite": "node scripts/generate-product-images.mjs --overwrite",
    "images:convert": "node scripts/convertToWebP.js",
    "images:convert:responsive": "node scripts/convertToWebP.js --responsive",
    "generate:sitemap": "node scripts/generate-sitemap-regex.cjs",
    "indexnow": "node scripts/submit-indexnow.js",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "npm run build && npm run preview & wait-on http://localhost:4173 && lhci autorun && kill %1",
    "test:all": "npm run test:unit && npm run test:e2e && npm run lighthouse",
    "migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "2.78.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "framer-motion": "11.18.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.5",
    "openai": "^6.39.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.10.1",
    "react-slick": "^0.31.0",
    "recharts": "^3.4.1",
    "slick-carousel": "^1.8.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@react-three/fiber": "^8.16.8",
    "@shadergradient/react": "^2.4.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "camera-controls": "^3.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "puppeteer": "^21.4.0",
    "react-snap": "^1.23.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.17",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.1.0",
    "wait-on": "^9.0.1",
    "workbox-window": "^7.3.0"
  }
}
